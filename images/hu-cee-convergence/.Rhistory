)
# ── join ─────────────────────────────────────────────────────────────
df_plot <- left_join(
df_hu, df_cee,
by = c("variable", "series_type", "metric_type", "period_group")
) %>%
mutate(
series_label = case_when(
grepl("vol", series_type) ~ grep("volume",names(color_fill_vals),value = T),
grepl("ppp_const", series_type) ~ grep("constant PPP",
names(color_fill_vals),value = T),
grepl("ppp_curr",  series_type) ~ grep("current",
names(color_fill_vals),value = T)
)
)
# ── period label + filename ──────────────────────────────────────────
period_label <- case_when(
period_choice == "earlier" ~ paste0("earlier baseline (",
paste(sort(unique(
df_all_eu8norm_init_final_vals$init_yr)),
collapse = "/"), ")"),
period_choice == "2010"    ~ "from 2010 baseline",
period_choice == "both"    ~ "all baselines"
)
file_name <- paste0(
"output/compare_units/summary/change/",
tolower(gsub(" ", "_", country_choice)), "_",
tolower(cee_choice), "_",
gsub("_", "-", agg_method), "_",
case_when(
period_choice == "earlier" ~ "earlier-baseline",
period_choice == "2010"    ~ "from-2010",
period_choice == "both"    ~ "both-baselines"
),
".png"
)
# ── plot ─────────────────────────────────────────────────────────────
p <- ggplot(df_plot, aes(x = series_label, color = series_label)) +
geom_point(
aes(y     = cee_agg,
fill  = series_label,
shape = cee_choice
# paste0(cee_choice, " (", agg_labels[agg_method], ")")
),
size = 6, stroke = 0.8,
color = "black",alpha=2/3 ) +
geom_text(
aes(y     = cee_agg,
label = paste0( round(cee_agg, 1))), # ifelse(cee_agg > 0, "+", ""),
vjust = -0.95, hjust = 0.5, size = 4.5, show.legend = FALSE
) +
geom_point(aes(y = hu_change, fill  = series_label,
shape = country_choice),
size = 6, stroke = 0.8,
color = "black",alpha=2/3 ) +
geom_text(
aes(y = hu_change, label = sprintf("%.1f", hu_change)),  # <-- always 1 decimal
hjust = -0.45, size = 4.5, show.legend = F) +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey50") +
geom_segment(
aes(x = series_label, xend = series_label,
y = hu_change,    yend = cee_agg),
linewidth = 1, linetype = "dotted", show.legend = FALSE
) +
scale_shape_manual(values = c(
setNames(22, cee_choice
# paste0(cee_choice, " (", agg_labels[agg_method], ")")
),
"Hungary" = 21
)) +
scale_fill_manual(values = color_fill_vals) +
scale_color_manual(values = color_fill_vals ) +
guides(
fill  = guide_legend(override.aes = list(shape = 21, color = "black")),
shape = guide_legend(override.aes = list(fill  = "grey50", color = "black"))
) +
scale_y_continuous(expand = expansion(c(0.02, 0.135))) +
scale_x_discrete(expand   = expansion(add = c(0.33, 0.77))) +
{ if (period_choice == "both") {
facet_grid(
metric_type + period_group ~ variable,
labeller = labeller(
variable     = dataset_labels,
metric_type  = metric_labels,
period_group = label_value
),
scales = "free_y"
)
} else {
facet_grid(
metric_type ~ variable,
labeller = labeller(
variable    = dataset_labels,
metric_type = metric_labels
),
scales = "free_y"
)
}
} +
labs(
title   = paste0(
country_choice, " vs ", cee_choice,
" - growth from ", period_label, " to 2024"
#  [", agg_labels[agg_method], "]
),
x       = "",
y       = "Change from baseline",
color   = metric_label_legend,
fill    = metric_label_legend,
shape   = "",
caption = paste0(
"Circle = ", country_choice, ". ",
"Square = ", cee_choice, " population-weighted aggregate",
" (method: ", agg_labels[agg_method], ").\n",
# "Dotted line connects the two.\n",
ifelse(nchar(start_year_note) > 0,
paste0(gsub("\n",", for ",start_year_note),
", 2004 for all others"),
"")
)
) +
theme_bw() + plot_settings +
theme(
legend.position    = "top",
legend.box         = "vertical",
axis.text.x        = element_blank(),
axis.ticks.x       = element_blank(),
panel.grid.minor   = element_blank(),
panel.grid.major.x = element_blank(),
strip.text.x       = element_text(size = 16),
strip.text.y       = element_text(size = 16),
plot.caption       = element_text(hjust = 0),
panel.spacing.y    = unit(0.5, "cm")
)
if (save_flag) {
ggsave(
plot      = p,
filename  = file_name,
width     = 48,
height    = ifelse(period_choice == "both", 30, 20),
units     = "cm",
limitsize = FALSE
)
}
try(print(p), silent = TRUE)
} # end agg_method
}   # end period_choice
}     # end cee_choice
}       # end country_choice
})
local({
save_flag <- T
# ── labels ──────────────────────────────────────────────────────────────────
dataset_labels <- c(
actual_indiv_consump   = "Actual Individual\nConsumption\n(Eurostat)",
average_annual_wages   = "Average annual\nwages\n(OECD)",
gdp_per_cap            = "GDP per\ncapita\n(World Bank)",
gdp_per_hr_worked      = "GDP per hour\nworked\n(OECD)",
gni_per_cap            = "GNI per\ncapita\n(World Bank)",
median_equiv_net_income= "Median equiv.\nnet income\n(Eurostat)",
median_hourly_earnings = "Median hourly\nearnings\n(Eurostat)"
)
metric_labels <- c(
foldchange = "Relative change (%)",
absdiff    = "Absolute change (pp)"
)
color_fill_vals <- c("constant PPP/PPS" = "#377EB8",
"current PPP/PPS" = "#4DAF4A",
"constant price (volume index, not PPP)" = "#E41A1C" )
metric_label_legend <- ""
agg_labels <- c(
wtd_levels  = "pop-weighted avg of levels → change",
wtd_changes = "pop-weighted avg of changes"
)
cee_filters <- list(
full_CEE = l_groups$list_cntrs$CEE,
CEE9     = setdiff(l_groups$list_cntrs$CEE, c("Czechia", "Slovenia"))
)
# ── caption ──────────────────────────────────────────────────────────────────
start_year_note <- df_all_eu8norm_init_final_vals %>%
distinct(variable, init_yr) %>%
filter(!init_yr %in% c(2004, 2010)) %>%
mutate(
label = gsub("\n",            " ", dataset_labels[variable]),
label = gsub("\\s*\\(.*?\\)", "", label),
label = trimws(label)
) %>%
arrange(init_yr) %>%
group_by(init_yr) %>%
summarise(note = paste(label, collapse = ", "),.groups = "drop") %>%
mutate(line = paste0(note, "=", init_yr)) %>%
pull(line) %>%
paste(collapse = "\n") %>%
paste0("Baseline year for ",.)
# ── population weights: THREE time points ────────────────────────────────────
df_pop_weights <- df_all_eu8norm_init_final_vals %>%
distinct(variable, country, init_yr, last_yr) %>%
mutate(yr_2010 = 2010L) %>%
pivot_longer(
cols      = c(init_yr, yr_2010, last_yr),
names_to  = "time_point",
values_to = "year_target"
) %>%
left_join(
l_pop$total_pop %>%
filter(year >= 2004) %>%
select(country, year_target = year, pop = value)
) %>%
select(variable, country, time_point, pop) %>%
pivot_wider(
names_from   = time_point,
values_from  = pop,
names_prefix = "pop_"
) %>%
rename(
pop_init = pop_init_yr,
pop_2010 = pop_yr_2010,
pop_last = pop_last_yr
)
# ── pre-compute CEE aggregates ────────────────────────────────────────────────
df_cee_aggs <- map_dfr(names(cee_filters), function(cee_choice) {
cntrs <- cee_filters[[cee_choice]]
df_base <- df_all_eu8norm_init_final_vals %>%
filter(country %in% cntrs, !is.na(unit_clean)) %>%
mutate(
series_type = case_when(
unit_clean == "constant price"   ~ "vol_index",
unit_clean == "constant PPP/PPS" ~ "ppp_const",
unit_clean == "current PPP/PPS"  ~ "ppp_current",
TRUE                             ~ NA_character_
)
) %>%
filter(!is.na(series_type)) %>%
left_join(df_pop_weights, by = c("variable", "country"))  # <-- now has pop_init/2010/last
# ── Approach A: weighted avg of LEVELS → then change ─────────────────────
df_A <- df_base %>%
group_by(variable, series_type) %>%
summarise(
wtd_val_init = weighted.mean(val_init, w = pop_init, na.rm = TRUE),  # <-- pop_init
wtd_val_2010 = weighted.mean(val_2010, w = pop_2010, na.rm = TRUE),  # <-- pop_2010
wtd_val_last = weighted.mean(val_last, w = pop_last, na.rm = TRUE),
# <-- pop_last.groups = "drop"
) %>%
pivot_longer(
cols      = c(wtd_val_init, wtd_val_2010),
names_to  = "period_base",
values_to = "base_val"
) %>%
mutate(
period_base  = recode(period_base,
wtd_val_init = "init",
wtd_val_2010 = "2010"),
period_group = ifelse(period_base == "2010", "from 2010", "from initial year"),
foldchange   = (wtd_val_last / base_val - 1) * 100,
absdiff      = wtd_val_last - base_val
) %>%
pivot_longer(
cols      = c(foldchange, absdiff),
names_to  = "metric_type",
values_to = "cee_agg"
) %>%
mutate(agg_method = "wtd_levels")
# ── Approach B: change per country → weighted avg ─────────────────────────
df_B <- df_base %>%
pivot_longer(
cols      = c(val_init, val_2010),
names_to  = "period_base",
values_to = "base_val"
) %>%
mutate(
period_base  = recode(period_base, val_init = "init", val_2010 = "2010"),
period_group = ifelse(period_base == "2010", "from 2010", "from initial year"),
# ── correct weight per period ────────────────────────────────────────
weight       = case_when(
period_base == "init" ~ pop_init,   # <-- pop at start of period
period_base == "2010" ~ pop_2010    # <-- pop at 2010
),
foldchange   = (val_last / base_val - 1) * 100,
absdiff      = val_last - base_val
) %>%
pivot_longer(
cols      = c(foldchange, absdiff),
names_to  = "metric_type",
values_to = "change"
) %>%
group_by(variable, series_type, metric_type, period_base, period_group) %>%
summarise(
cee_agg = weighted.mean(change, w = weight, na.rm = TRUE),.groups = "drop"
) %>%
mutate(agg_method = "wtd_changes")
bind_rows(df_A, df_B) %>%
mutate(cee_filter = cee_choice)
})
# ── Hungary long ─────────────────────────────────────────────────────────────
df_hu_long <- df_all_eu8norm_init_final_vals %>%
filter(!is.na(unit_clean)) %>%
mutate(
series_type = case_when(
unit_clean == "constant price"   ~ "vol_index",
unit_clean == "constant PPP/PPS" ~ "ppp_const",
unit_clean == "current PPP/PPS"  ~ "ppp_current",
TRUE                             ~ NA_character_
)
) %>%
filter(!is.na(series_type)) %>%
pivot_longer(
cols      = c(val_init, val_2010),
names_to  = "period_base",
values_to = "base_val"
) %>%
mutate(
period_base  = recode(period_base, val_init = "init", val_2010 = "2010"),
period_group = ifelse(period_base == "2010", "from 2010", "from initial year"),
foldchange   = (val_last / base_val - 1) * 100,
absdiff      = val_last - base_val
) %>%
pivot_longer(
cols      = c(foldchange, absdiff),
names_to  = "metric_type",
values_to = "hu_change"
)
# ── outer loops ──────────────────────────────────────────────────────────────
for (country_choice in c("Hungary")) {
for (cee_choice in c("CEE9", "full_CEE")) {
for (period_choice in c("earlier", "2010", "both")) {
for (agg_method in c("wtd_levels", "wtd_changes")) {
# ── filter Hungary ───────────────────────────────────────────────────
df_hu <- df_hu_long %>%
filter(
country == country_choice,
case_when(
period_choice == "earlier" ~ period_base != "2010",
period_choice == "2010"    ~ period_base == "2010",
period_choice == "both"    ~ TRUE
)
) %>%
mutate(
series_type  = factor(series_type,
levels = c("vol_index", "ppp_const", "ppp_current")),
metric_type  = factor(metric_type,
levels = c("foldchange", "absdiff")),
period_group = factor(period_group,
levels = c("from initial year", "from 2010"))
)
# ── filter CEE agg ───────────────────────────────────────────────────
df_cee <- df_cee_aggs %>%
filter(
cee_filter  == cee_choice,
agg_method  == !!agg_method,
case_when(
period_choice == "earlier" ~ period_base != "2010",
period_choice == "2010"    ~ period_base == "2010",
period_choice == "both"    ~ TRUE
)
) %>%
mutate(
series_type  = factor(series_type,
levels = c("vol_index", "ppp_const", "ppp_current")),
metric_type  = factor(metric_type,
levels = c("foldchange", "absdiff")),
period_group = factor(period_group,
levels = c("from initial year", "from 2010"))
)
# ── join ─────────────────────────────────────────────────────────────
df_plot <- left_join(
df_hu, df_cee,
by = c("variable", "series_type", "metric_type", "period_group")
) %>%
mutate(
series_label = case_when(
grepl("vol", series_type) ~ grep("volume",names(color_fill_vals),value = T),
grepl("ppp_const", series_type) ~ grep("constant PPP",
names(color_fill_vals),value = T),
grepl("ppp_curr",  series_type) ~ grep("current",
names(color_fill_vals),value = T)
)
)
# ── period label + filename ──────────────────────────────────────────
period_label <- case_when(
period_choice == "earlier" ~ paste0("earlier baseline (",
paste(sort(unique(
df_all_eu8norm_init_final_vals$init_yr)),
collapse = "/"), ")"),
period_choice == "2010"    ~ "from 2010 baseline",
period_choice == "both"    ~ "all baselines"
)
file_name <- paste0(
"output/compare_units/summary/change/",
tolower(gsub(" ", "_", country_choice)), "_",
tolower(cee_choice), "_",
gsub("_", "-", agg_method), "_",
case_when(
period_choice == "earlier" ~ "earlier-baseline",
period_choice == "2010"    ~ "from-2010",
period_choice == "both"    ~ "both-baselines"
),
".png"
)
# ── plot ─────────────────────────────────────────────────────────────
p <- ggplot(df_plot, aes(x = series_label, color = series_label)) +
geom_point(
aes(y     = cee_agg,
fill  = series_label,
shape = cee_choice
# paste0(cee_choice, " (", agg_labels[agg_method], ")")
),
size = 6, stroke = 0.8,
color = "black",alpha=2/3 ) +
geom_text(
aes(y     = cee_agg,
label = paste0( round(cee_agg, 1))), # ifelse(cee_agg > 0, "+", ""),
vjust = -0.95, hjust = 0.5, size = 4.5, show.legend = FALSE
) +
geom_point(aes(y = hu_change, fill  = series_label,
shape = country_choice),
size = 6, stroke = 0.8,
color = "black",alpha=2/3 ) +
geom_text(
aes(y = hu_change, label = sprintf("%.1f", hu_change)),  # <-- always 1 decimal
hjust = -0.45, size = 4.5, show.legend = F) +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey50") +
geom_segment(
aes(x = series_label, xend = series_label,
y = hu_change,    yend = cee_agg),
linewidth = 1, linetype = "dotted", show.legend = FALSE
) +
scale_shape_manual(values = c(
setNames(22, cee_choice
# paste0(cee_choice, " (", agg_labels[agg_method], ")")
),
"Hungary" = 21
)) +
scale_fill_manual(values = color_fill_vals) +
scale_color_manual(values = color_fill_vals ) +
guides(
fill  = guide_legend(override.aes = list(shape = 21, color = "black")),
shape = guide_legend(override.aes = list(fill  = "grey50", color = "black"))
) +
scale_y_continuous(expand = expansion(c(0.02, 0.135))) +
scale_x_discrete(expand   = expansion(add = c(0.33, 0.77))) +
{ if (period_choice == "both") {
facet_grid(
metric_type + period_group ~ variable,
labeller = labeller(
variable     = dataset_labels,
metric_type  = metric_labels,
period_group = label_value
),
scales = "free_y"
)
} else {
facet_grid(
metric_type ~ variable,
labeller = labeller(
variable    = dataset_labels,
metric_type = metric_labels
),
scales = "free_y"
)
}
} +
labs(
title   = paste0(
country_choice, " vs ", cee_choice,
" - growth from ", period_label, " to 2024"
#  [", agg_labels[agg_method], "]
),
x       = "",
y       = "Change from baseline",
color   = metric_label_legend,
fill    = metric_label_legend,
shape   = "",
caption = paste0(
"Circle = ", country_choice, ". ",
"Square = ", cee_choice, " population-weighted aggregate",
" (method: ", agg_labels[agg_method], ").\n",
# "Dotted line connects the two.\n",
ifelse(nchar(start_year_note) > 0,
paste0(gsub("\n",", for ",start_year_note),
", 2004 for all others"),
"")
)
) +
theme_bw() + plot_settings +
theme(
legend.position    = "top",
legend.box         = "vertical",
axis.text.x        = element_blank(),
axis.ticks.x       = element_blank(),
panel.grid.minor   = element_blank(),
panel.grid.major.x = element_blank(),
strip.text.x       = element_text(size = 16),
strip.text.y       = element_text(size = 16),
plot.caption       = element_text(hjust = 0),
panel.spacing.y    = unit(0.5, "cm")
)
if (save_flag) {
ggsave(
plot      = p,
filename  = file_name,
width     = 48,
height    = ifelse(period_choice == "both", 30, 20),
units     = "cm",
limitsize = FALSE
)
}
try(print(p), silent = TRUE)
} # end agg_method
}   # end period_choice
}     # end cee_choice
}       # end country_choice
})
