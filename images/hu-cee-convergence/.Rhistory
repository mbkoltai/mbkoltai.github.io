median_hourly_earnings = "Medián órabér (Eurostat)"
)
# ── harmonise ────────────────────────────────────────────────────────────────
df_data <- df_all_eu8norm_init_final_vals %>%
filter(!is.na(unit_clean)) %>%
group_by(variable, country) %>%
mutate(country_units = n_distinct(unit_clean)) %>%
