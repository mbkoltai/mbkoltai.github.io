relocate(c(lako_nepesseg,összes_vp),.after = telepules)
df_ogy2026 %>%
filter(lako_nepesseg>=1e3 & lako_nepesseg<=2e3)
df_ogy2026 %>%
filter(lako_nepesseg>=1e3 & lako_nepesseg<=2e3) %>%
group_by(part) %>%
summarise(sum(szavazat))
View(df_ogy2026)
df_ogy2026 %>% select(telepules,lako_nepesseg,összes_vp,part,szavazat)
df_ogy2026 %>%
select(telepules,lako_nepesseg,összes_vp,part,szavazat) %>%
pivot_wider(values_from = szavazat,names_from = part)
df_ogy2026 %>%
select(telepules,lako_nepesseg,összes_vp,part,szavazat) %>%
pivot_wider(values_from = szavazat,names_from = part)  %>%
summarise(across(where(is.numeric), sum, na.rm = TRUE))
df_ogy2026 %>%
select(telepules,lako_nepesseg,összes_vp,part,szavazat) %>%
pivot_wider(values_from = szavazat,names_from = part)  %>%
summarise(across(where(is.numeric), \(x) sum(x, na.rm = TRUE)))
