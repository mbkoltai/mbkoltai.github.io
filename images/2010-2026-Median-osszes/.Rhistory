legend.position = "top",
axis.text.x   = element_text(size = 12, hjust = 0.5)  # centred for multiline
)
# ── Two versions ─────────────────────────────────────────────────────────
plots <- list(
no_loess = p_base,
loess    = p_base +
geom_smooth(aes(colour=party),
method = "loess", se = FALSE,
linewidth=2,span=0.6,alpha=0.1)
)
if (save_flag) {
for (nm in names(plots)) {
ggsave(
filename = paste0("plots/kvk/median_zav_21kk_comparison_", nm, ".png"),
plot     = plots[[nm]],
width    = 40, height = 22, units = "cm" )
}
}
})
