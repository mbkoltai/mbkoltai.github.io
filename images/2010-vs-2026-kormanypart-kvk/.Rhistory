geom_text(data=er,
aes(x=.x, y=ertek, colour=part,
label=sprintf("%.1f%%", ertek)),
inherit.aes=F, vjust=-1/2, hjust=-1/8,
size=4, fontface="bold", show.legend=F) +
facet_wrap(~ ciklus, nrow=1, scales=facet_scales) +
scale_colour_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown)) +
scale_fill_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown), guide="none") +
scale_linetype_manual(values=c("Új kormánypárt"   ="solid",
"Bukott kormánypárt"="22"),
name="Szerep") +
scale_shape_manual(values=c(23), name=NULL) +   # 23 = keretezhető rombusz
x_scale +
scale_y_continuous(breaks=seq(0, 70, 10), labels=function(y) paste0(y, "%")) +
coord +
labs(
title="Új kormánypárt vs. ellenzék a 2010-es és a 2026-os választás körül",
subtitle=paste("Medián pártpreferencia-mérések a TELJES NÉPESSÉG körében;",
if (x_mode == "datum") "abszolút időskálán"
else "a választás időpontjához viszonyítva"),
x=x_felirat,
y="Támogatottság a teljes népesség %-ában",
caption=cap    ) +
guides(
colour  =guide_legend(order=1, override.aes=list(linetype="solid", shape=NA)),
linetype=guide_legend(order=2, override.aes=list(colour="grey20")),
shape   =guide_legend(order=3, override.aes=list(colour="black", fill=NA, size=4))
) +
theme_bw(base_size=12) +
theme(
strip.text      =element_text(face="bold", size=11, lineheight=1.15),
# strip.background=element_rect(fill="grey94", colour=NA),
panel.grid.minor=element_blank(),
legend.position ="top",
legend.box      ="horizontal",
plot.title      =element_text(face="bold"),
plot.caption    =element_text(colour="grey40", hjust=0))
attr(p, "x_mode") <- x_mode              # <- rásütjük a módot a plotra
attr(p, "nincs")  <- !is.null(nincs)     # <- volt-e szürke nincs_partja vonal
p
}
# ---- Futtatás --------------------------------------------------------------
cfg  <- make_config()
data <- list(
felmeresek=build_felmeresek(read_polls(cfg), cfg),
eredmenyek=build_eredmenyek(cfg),
nincs     =build_nincs(read_polls(cfg), cfg) )
# gyors ellenőrzés
print(data$felmeresek %>% count(panel, part, ciklus))
print(data$eredmenyek %>% select(panel, part, ciklus, ertek))
# ---- mentés loop-ban: minden max_span × x_mode kombináció -------------------
# max_span: ± nap a választáshoz képest ; x_mode: relatív hónap VAGY naptári dátum
# Csak a build_plot_ido tud dátumtengelyt, ezért a dupla ciklus arra vonatkozik.
local({
max_time_span <- c(200, 360, 650,740,1100)
x_modok    <- c("relativ", "datum")
# naptári tengely lépésköze a window-hoz igazodik (hónap)
datum_break <- c("200"=2, "360"=4, "650"=6,"740"=6,"1100"=6)
abrak <- list()
# 1. ábra: SZEREP szerinti panelek (csak relatív idő, nincs x_mode)
for (ms in max_time_span) {
p_i <- build_plot(data$felmeresek, data$eredmenyek, cfg, max_span=ms)
fajl <- abra_fajlnev("median_szerep", p_i)
ggsave(plot=p_i, filename=paste0("plots/", fajl),
width=12, height=6, dpi=300, bg="white")
abrak[[fajl]] <- p_i
message("mentve: ", fajl)
}
# 2. ábra: IDŐSZAK szerinti panelek (relatív ÉS naptári x tengely)
for (ms in max_time_span) {
for (xm in x_modok) {
p_i <- build_plot_ido(data$felmeresek, data$eredmenyek, cfg,
max_span=ms, x_mode=xm,
breaks_ho=c(relativ=2,
datum=datum_break[[as.character(ms)]]),
nincs=data$nincs)
fajl <- abra_fajlnev("median_idoszak", p_i)
ggsave(plot=p_i, filename=paste0("plots/", fajl),
width=12, height=6, dpi=300, bg="white")
abrak[[fajl]] <- p_i
message("mentve: ", fajl)
}
}
})
# =============================================================================
#  VÁLASZTÁSOK + Medián pártpreferencia — 2010 vs. 2026
#  1. ábra (p):  panelek SZEREP szerint  ("Új kormánypárt" / "Bukott kormánypárt")
#  2. ábra (p2): panelek IDŐSZAK szerint (2010-es vs. 2026-os választás)
#  Minden adat: TELJES NÉPESSÉG. X tengely: választáshoz viszonyított idő (hónap)
#
#  DK-korrekció: a DK (2011-11-13-tól, ~+19,1 hónap a 2010-es választáshoz képest)
#  az MSZP-ből kivált frakció, ezért támogatottságát hozzáadjuk az MSZP-hez.
#  A csillag (MSZP*) + lábjegyzet ADAPTÍV: csak akkor jelenik meg, ha a megjelenített
#  időablak (max_span) tényleg tartalmaz DK-val összevont MSZP-pontot.
#  A mentett fájlnév is ADAPTÍV: az ablak választás előtti/utáni hónapjait tükrözi.
# =============================================================================
library(readr)
library(dplyr)
library(tidyr)
library(ggplot2)
rm(list=ls())
# ---- Konfiguráció ----------------------------------------------------------
make_config <- function() {
valasztas <- tibble(
ev             =c(2010L, 2026L),
valasztas_datum=as.Date(c("2010-04-11", "2026-04-12"))
)
szeriak <- tribble(
~panel_kod, ~part,    ~ev,    ~kezdet,        ~veg,
"uj",       "Fidesz", 2010L,  "2009-01-01",   "2014-04-06",
"bukott",   "MSZP",   2010L,  "2009-01-01",   "2014-04-06",
"uj",       "Tisza",  2026L,  "2025-01-01",   "2026-12-31",
"bukott",   "Fidesz", 2026L,  "2025-02-01",   "2026-12-31"
) %>%
mutate(across(c(kezdet, veg), as.Date)) %>%
left_join(valasztas, by="ev")
list(
files=list(
polls ="inputs/median_polls.csv",                    # 2009 - 2026/05 (long)
median="inputs/Median_teljes_nepesseg_osszes.csv",   # 2024 - 2026/07 (wide)
val   ="inputs/val_eredmenyek.csv"
),
valasztas    =valasztas,
szeriak      =szeriak,
nap_per_honap=30.4375,   # relatív idő egysége: hónap (tizedes)
# X tengely: NULL=a coord_cartesian szabadon hagyja.
# Közös ablakhoz állítsd pl.: x_ablak=c(-16, 5)
x_ablak      =NULL,
# A 2026-05-01-es hullám valós közepe 2026-04-30 -> erre javítjuk.
datum_javitas=c("2026-05-01"="2026-04-30"),
panel_cimkek =c(
uj    ="Új kormánypárt (2/3-os többség)\nFidesz 2010  vs.  TISZA 2026",
bukott="Bukott kormánypárt\nMSZP 2010  vs.  Fidesz 2026"
),
part_szinek  =c("Fidesz"="#F26522", "MSZP"="#D0021B", "TISZA"="blue"),
dk_labjegyzet=paste0("* Az MSZP idősora 2011 novemberétől az MSZP és a ",
"belőle kivált DK együttes támogatottsága.")
)
}
# ---- Segéd: dátumjavítás ---------------------------------------------------
javit_datum <- function(x, jav) {
ha <- as.Date(names(jav)); ra <- as.Date(unname(jav))
for (i in seq_along(jav)) x <- if_else(x == ha[i], ra[i], x)
x
}
# ---- Segéd: DK összevonása az MSZP-vel -------------------------------------
# A két párt támogatottságát dátumonként összeadjuk, MSZP néven. A dk_benne
# jelző igaz azoknál az MSZP-pontoknál, ahol ténylegesen volt DK-adat is
# (ez vezérli később az adaptív csillagot).
osszevon_mszp_dk <- function(polls) {
mszp_dk <- polls %>%
filter(part %in% c("MSZP", "DK")) %>%
group_by(datum) %>%
summarise(teljes_nepesseg=sum(teljes_nepesseg, na.rm=TRUE),
dk_benne        =any(part == "DK"),
.groups="drop") %>%
mutate(part="MSZP")
polls %>%
filter(!part %in% c("MSZP", "DK")) %>%
mutate(dk_benne=F) %>%
bind_rows(mszp_dk) %>%
arrange(part, datum)
}
# ---- Felmérések beolvasása + összefésülés ----------------------------------
read_polls <- function(cfg) {
# CSV1 (long)
polls1 <- read_csv(cfg$files$polls, na=c("", "NA"), show_col_types=F) %>%
select(part, datum, teljes_nepesseg) %>%
mutate(datum=javit_datum(as.Date(datum), cfg$datum_javitas)) %>%
filter(!is.na(teljes_nepesseg))
# CSV2 (wide) — csak "Teljes népesség", csak TISZA + Fidesz.
# A dátumok itt hónapra kerekítettek, ezért CSAK a CSV1 utolsó időpontja
# UTÁNI hullámokat vesszük át (2026-06-25 és 2026-07-23).
polls2 <- read_csv(cfg$files$median, na=c("", "NA"), show_col_types=F) %>%
filter(kateg == "Teljes népesség") %>%
mutate(datum=javit_datum(as.Date(datum, format="%Y/%m/%d"), cfg$datum_javitas)) %>%
select(datum, TISZA, Fidesz, Pártnélküli) %>%                       # <- +Pártnélküli
pivot_longer(c(TISZA, Fidesz, Pártnélküli),                          # <- ide is
names_to="part", values_to="teljes_nepesseg") %>%
mutate(part=recode(part, "TISZA"="Tisza",
"Pártnélküli"="nincs_partja")) %>%      # <- átnevezés
filter(!is.na(teljes_nepesseg), datum > max(polls1$datum))
bind_rows(polls1, polls2) %>%
osszevon_mszp_dk() %>%
arrange(part, datum)
}
# ---- Sorozatokká alakítás (relatív idő, panel, ciklus, párt, szerep) --------
label_kozos <- function(df, cfg) {
df %>%
mutate(
panel =factor(panel_kod, levels=names(cfg$panel_cimkek),
labels=cfg$panel_cimkek),
szerep=factor(panel_kod, levels=c("uj", "bukott"),
labels=c("Új kormánypárt", "Bukott kormánypárt")),
ciklus=factor(ev, levels=c(2010, 2026),
labels=c("2010-es választás", "2026-os választás")),
part  =factor(part, levels=c("Fidesz", "MSZP", "Tisza"),
labels=c("Fidesz", "MSZP", "TISZA"))
)
}
build_felmeresek <- function(polls, cfg) {
polls %>%
inner_join(cfg$szeriak, by="part", relationship="many-to-many") %>%
filter(datum >= kezdet, datum <= veg) %>%
mutate(rel_honap=as.numeric(datum - valasztas_datum) / cfg$nap_per_honap) %>%
label_kozos(cfg)
}
# ---- nincs_partja szürke idősor, hiánypótlással ----------------------------
# A régi Medián-hullámoknál gyakran nem közöltek külön "nincs pártja / NT-NV"
# sávot. Ez a szám azonban rekonstruálható: nincs_partja=100 - Σ(összes párt,
# az "egyeb"-et is beleértve). Ez PONTOS, de CSAK ha az "egyeb" is közölve van
# (különben a kis pártok tévesen a nincs_partja-ba olvadnának) -> ezért kapuzzuk.
build_nincs <- function(polls, cfg, potol_hianyt=TRUE) {
# 1) meglévő, közölt nincs_partja pontok
kozolt <- polls %>%
filter(part == "nincs_partja", !is.na(teljes_nepesseg)) %>%
select(datum, teljes_nepesseg)
if (potol_hianyt) {
# 2) rekonstrukció: dátumonként Σ(összes párt) és van-e "egyeb"
osszeg <- polls %>%
filter(part != "nincs_partja") %>%
group_by(datum) %>%
summarise(part_ossz=sum(teljes_nepesseg, na.rm=TRUE),
van_egyeb=any(part == "egyeb" & !is.na(teljes_nepesseg)),
.groups="drop")
potolt <- osszeg %>%
filter(van_egyeb, !datum %in% kozolt$datum) %>%      # csak a tényleg hiányzókra
transmute(datum, teljes_nepesseg=100 - part_ossz) %>%
filter(teljes_nepesseg >= 0, teljes_nepesseg <= 100)  # épség-ellenőrzés
nincs_pontok <- bind_rows(kozolt, potolt) %>% arrange(datum)
} else {
nincs_pontok <- kozolt
}
# 3) minden (panel × ev) ablakra kiosztjuk (egy pont több panelbe is kerülhet)
ablakok <- cfg$szeriak %>%
distinct(panel_kod, ev, kezdet, veg, valasztas_datum)
nincs_pontok %>%
inner_join(ablakok, by=character()) %>%
filter(datum >= kezdet, datum <= veg) %>%
mutate(part     ="nincs_partja",
rel_honap=as.numeric(datum - valasztas_datum) / cfg$nap_per_honap) %>%
label_kozos(cfg)
}
build_eredmenyek <- function(cfg) {
read_csv(cfg$files$val, show_col_types=F) %>%
filter(valasztas_tipusa == "ogy") %>%
mutate(ertek=100 * lista_szavazat / jogosult) %>%
select(ev, part, ertek) %>%
inner_join(cfg$szeriak, by=c("ev", "part")) %>%
mutate(rel_honap=0) %>%
label_kozos(cfg)
}
# ---- Adaptív segédek: ablakszűrés, párt-címkék, fájlnév --------------------
# Időablak szűrése (a választáshoz képest ± max_span nap).
szur_ablak <- function(felmeresek, max_span) {
felmeresek %>%
group_by(ev) %>%
filter(abs(datum - valasztas_datum) <= max_span) %>%
ungroup()
}
# Relatív x tengely lépésköze a window-hoz igazodik (± max_span nap -> hónap-lépés)
rel_break <- function(max_span, nap_per_honap = 30.4375) {
span_ho <- 2 * max_span / nap_per_honap        # a teljes megjelenített szélesség hónapban
if      (span_ho <= 16) 2                       # ~±6-8 hó   -> 2 havonta
else if (span_ho <= 30) 3                       # ~±8-15 hó  -> 3 havonta
else                    6                        # ennél szélesebb -> 6 havonta
}
# Párt-címkék a színjelmagyarázathoz: MSZP -> "MSZP*" CSAK ha DK is látszik.
cimke_part <- function(dk_shown) {
c(Fidesz="Fidesz",
MSZP  =if (dk_shown) "MSZP*" else "MSZP",
TISZA ="TISZA")
}
# Adaptív fájlnév a megjelenített ablak alapján (választás előtti/utáni hónap).
# Pl. -7 .. +7 hónap  ->  "median_szerep_-7_+7ho.png"
abra_fajlnev <- function(alap, plot) {
df     <- plot$data
x_mode <- attr(plot, "x_mode") %||% "relativ"
nincs  <- isTRUE(attr(plot, "nincs"))                 # a rásütött jelző
lo <- round(min(df$rel_honap))
hi <- round(max(df$rel_honap))
sprintf("%s_%s%s_%+d_%+dho.png",
alap, x_mode, if (nincs) "_NTNV" else "", lo, hi)
}
# ---- 1. ábra: panelek SZEREP szerint ---------------------------------------
build_plot <- function(felmeresek, eredmenyek, cfg, max_span) {
df <- szur_ablak(felmeresek, max_span)
dk_shown <- any(df$dk_benne)     # csak akkor csillag, ha DK-pont is látszik
br <- rel_break(max_span)          # <- adaptív lépésköz
cap <- paste0("Forrás: Medián / hvg.hu; választási eredmény: NVI ",
"(listás szavazat a névjegyzékben szereplők arányában).",
"\nVálasztások: 2010. április 11., 2026. április 12.")
if (dk_shown) cap <- paste0(cap, "\n", cfg$dk_labjegyzet)
ggplot(df, aes(x=rel_honap, y=teljes_nepesseg,
colour=part, linetype=ciklus)) +
geom_vline(xintercept=0, linetype="dashed", colour="grey40",
linewidth=0.4) +
annotate("text", x=0, y=66, label="választás napja",
hjust=-0.06, vjust=1,
size=3, colour="grey35") +
geom_line(linewidth=0.7, alpha=2/3) +
geom_point(size=2.5, shape=16, alpha=0.74) +
# tényleges eredmény — keretezett rombusz (fill=párt, fekete keret)
geom_point(data=eredmenyek, aes(x=rel_honap, y=ertek, fill=part,
shape=paste0("Tényleges választási eredmény\n",
"(listás szavazat / névjegyzékben szereplők)")),
inherit.aes=F, size=4.2, stroke=0.4, colour="black") +
geom_text(data=eredmenyek,
aes(x=rel_honap, y=ertek, colour=part,
label=sprintf("%.1f%%", ertek)),
inherit.aes=F, vjust=-1/2, hjust=-1/8,
size=4,
fontface="bold", show.legend=F) +
facet_wrap(~ panel, nrow=1) +
scale_colour_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown)) +
scale_fill_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown), guide="none") +
scale_linetype_manual(values=c("2010-es választás"="solid",
"2026-os választás"="22"),
name="Ciklus") +
scale_shape_manual(values=c(23), name=NULL) +   # 23 = keretezhető rombusz
# scale_x_continuous(breaks=seq(-18, 36, 2),
#                    labels=function(x) ifelse(x > 0, paste0("+", x), as.character(x))) +
scale_x_continuous(breaks=seq(-36, 48, by=br),
labels=function(x) ifelse(x > 0, paste0("+", x), as.character(x))) +
scale_y_continuous(breaks=seq(0, 70, 10), labels=function(y) paste0(y, "%")) +
coord_cartesian(xlim=cfg$x_ablak, ylim=c(0, 68)) +
labs(
title="Új vs leváltott kormánypárt támogatottsága 2010 és 2026",
subtitle=paste("Medián pártpreferencia-mérések a TELJES NÉPESSÉG körében;",
"a választás időpontjához viszonyítva"),
x="Idő a választáshoz képest (hónap)",
y="Támogatottság a teljes népesség %-ában",
caption=cap
) +
guides(
colour  =guide_legend(order=1, override.aes=list(linetype="solid", shape=NA)),
linetype=guide_legend(order=2, override.aes=list(colour="grey20")),
shape   =guide_legend(order=3, override.aes=list(colour="black", fill=NA, size=4))
) +
theme_bw(base_size=12) +
theme(
strip.text      =element_text(face="bold", size=11, lineheight=1.15),
# strip.background=element_rect(fill="grey94", colour=NA),
panel.grid.minor=element_blank(),
legend.position ="top",
legend.box      ="horizontal",
plot.title      =element_text(face="bold"),
plot.caption    =element_text(colour="grey40", hjust=0))
}
# ---- 2. ábra: panelek IDŐSZAK szerint --------------------------------------
# Panelek: 2010-es vs. 2026-os választás.  Színt=párt, vonaltípus=szerep
# (Új kormánypárt=folytonos, Bukott=szaggatott). Így a Fidesz mindkét
# panelen narancs, de 2010-ben folytonos (új), 2026-ban szaggatott (bukott).
build_plot_ido <- function(felmeresek, eredmenyek, cfg, max_span,
x_mode=c("relativ", "datum"),
breaks_ho=c(relativ=2, datum=6),
nincs=NULL) {
x_mode <- match.arg(x_mode)
br <- breaks_ho[[x_mode]]   # az adott módhoz tartozó lépésköz (hónap)
df <- szur_ablak(felmeresek, max_span)
dk_shown <- any(df$dk_benne)
cap <- paste0("Forrás: Medián / hvg.hu; választási eredmény: NVI ",
"(listás szavazat a névjegyzékben szereplők arányában).",
"\nVálasztások: 2010. április 11., 2026. április 12.")
if (dk_shown) cap <- paste0(cap, "\n", cfg$dk_labjegyzet)
# a relatív lépésköz a window-hoz igazodjon (mint a szerep-ábrán)
br_rel <- rel_break(max_span)
# --- x tengely mód: relatív hónap VAGY abszolút dátum ---
if (x_mode == "datum") {
df  <- df %>% mutate(.x=datum)
er  <- eredmenyek %>% mutate(.x=valasztas_datum)
vlines <- cfg$valasztas %>%
mutate(.x=valasztas_datum) %>%
left_join(distinct(df, ev, ciklus), by="ev")
x_scale      <- scale_x_date(date_labels="%Y.%m",
date_breaks=paste(br, "months"))   # pl. "6 months"
facet_scales <- "free_x"
x_felirat    <- "Dátum"
coord        <- coord_cartesian(ylim=c(0, 68))
} else {
df  <- df %>% mutate(.x=rel_honap)
er  <- eredmenyek %>% mutate(.x=rel_honap)
vlines <- tibble(.x=0)
x_scale <- scale_x_continuous(
breaks = seq(-36, 48, by = br_rel),
labels = function(x) ifelse(x > 0, paste0("+", x), as.character(x)))
facet_scales <- "fixed"
x_felirat    <- "Idő a választáshoz képest (hónap)"
coord        <- coord_cartesian(xlim=cfg$x_ablak, ylim=c(0, 68))
}
# nincs_partja szürke réteg adatai (ha kértük)
ndf <- NULL
if (!is.null(nincs)) {
ndf <- szur_ablak(nincs, max_span) %>%
mutate(.x=if (x_mode == "datum") datum else rel_honap)
}
p <- ggplot(df, aes(x=.x, y=teljes_nepesseg,
colour=part, linetype=szerep)) +
geom_vline(data=vlines, aes(xintercept=.x),
linetype="dashed", colour="grey40", linewidth=0.4,
inherit.aes=F) +
geom_text(data=vlines, aes(x=.x, y=66, label="választás napja"),
inherit.aes=F, hjust=-0.06, vjust=1,
size=3, colour="grey35") +
geom_line(linewidth=0.7, alpha=2/3) +
geom_point(size=2.5, shape=16, alpha=0.74) +
{ if (!is.null(ndf))
list(
geom_line(data=ndf, aes(x=.x, y=teljes_nepesseg, group=ciklus),
inherit.aes=F, colour="grey60",
linewidth=0.6, alpha=0.9),
geom_point(data=ndf, aes(x=.x, y=teljes_nepesseg),
inherit.aes=F, colour="grey60",
size=1.6, alpha=0.8)
)
else NULL } +
# tényleges eredmény — keretezett rombusz (fill=párt, fekete keret)
geom_point(data=er,
aes(x=.x, y=ertek, fill=part,
shape=paste0("Tényleges választási eredmény\n",
"(listás szavazat / névjegyzékben szereplők)")),
inherit.aes=F, size=4.2, stroke=0.4, colour="black") +
geom_text(data=er,
aes(x=.x, y=ertek, colour=part,
label=sprintf("%.1f%%", ertek)),
inherit.aes=F, vjust=-1/2, hjust=-1/8,
size=4, fontface="bold", show.legend=F) +
facet_wrap(~ ciklus, nrow=1, scales=facet_scales) +
scale_colour_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown)) +
scale_fill_manual(values=cfg$part_szinek, name="Párt",
labels=cimke_part(dk_shown), guide="none") +
scale_linetype_manual(values=c("Új kormánypárt"   ="solid",
"Bukott kormánypárt"="22"),
name="Szerep") +
scale_shape_manual(values=c(23), name=NULL) +   # 23 = keretezhető rombusz
x_scale +
scale_y_continuous(breaks=seq(0, 70, 10), labels=function(y) paste0(y, "%")) +
coord +
labs(
title="Új kormánypárt vs. ellenzék a 2010-es és a 2026-os választás körül",
subtitle=paste("Medián pártpreferencia-mérések a TELJES NÉPESSÉG körében;",
if (x_mode == "datum") "abszolút időskálán"
else "a választás időpontjához viszonyítva"),
x=x_felirat,
y="Támogatottság a teljes népesség %-ában",
caption=cap    ) +
guides(
colour  =guide_legend(order=1, override.aes=list(linetype="solid", shape=NA)),
linetype=guide_legend(order=2, override.aes=list(colour="grey20")),
shape   =guide_legend(order=3, override.aes=list(colour="black", fill=NA, size=4))
) +
theme_bw(base_size=12) +
theme(
strip.text      =element_text(face="bold", size=11, lineheight=1.15),
# strip.background=element_rect(fill="grey94", colour=NA),
panel.grid.minor=element_blank(),
legend.position ="top",
legend.box      ="horizontal",
plot.title      =element_text(face="bold"),
plot.caption    =element_text(colour="grey40", hjust=0))
attr(p, "x_mode") <- x_mode              # <- rásütjük a módot a plotra
attr(p, "nincs")  <- !is.null(nincs)     # <- volt-e szürke nincs_partja vonal
p
}
# ---- Futtatás --------------------------------------------------------------
cfg  <- make_config()
data <- list(
felmeresek=build_felmeresek(read_polls(cfg), cfg),
eredmenyek=build_eredmenyek(cfg),
nincs     =build_nincs(read_polls(cfg), cfg) )
# gyors ellenőrzés
print(data$felmeresek %>% count(panel, part, ciklus))
print(data$eredmenyek %>% select(panel, part, ciklus, ertek))
# ---- mentés loop-ban: minden max_span × x_mode kombináció -------------------
# max_span: ± nap a választáshoz képest ; x_mode: relatív hónap VAGY naptári dátum
# Csak a build_plot_ido tud dátumtengelyt, ezért a dupla ciklus arra vonatkozik.
local({
max_time_span <- c(200, 360, 650,740,1100)
x_modok    <- c("relativ", "datum")
# naptári tengely lépésköze a window-hoz igazodik (hónap)
datum_break <- c("200"=2, "360"=4, "650"=6,"740"=6,"1100"=6)
abrak <- list()
# 1. ábra: SZEREP szerinti panelek (csak relatív idő, nincs x_mode)
for (ms in max_time_span) {
p_i <- build_plot(data$felmeresek, data$eredmenyek, cfg, max_span=ms)
fajl <- abra_fajlnev("median_szerep", p_i)
ggsave(plot=p_i, filename=paste0("plots/", fajl),
width=12, height=6, dpi=300, bg="white")
abrak[[fajl]] <- p_i
message("mentve: ", fajl)
}
# 2. ábra: IDŐSZAK szerinti panelek (relatív ÉS naptári x tengely)
for (ms in max_time_span) {
for (xm in x_modok) {
p_i <- build_plot_ido(data$felmeresek, data$eredmenyek, cfg,
max_span=ms, x_mode=xm,
breaks_ho=c(relativ=2,
datum=datum_break[[as.character(ms)]]),
nincs=data$nincs)
fajl <- abra_fajlnev("median_idoszak", p_i)
ggsave(plot=p_i, filename=paste0("plots/", fajl),
width=12, height=6, dpi=300, bg="white")
abrak[[fajl]] <- p_i
message("mentve: ", fajl)
}
}
})
